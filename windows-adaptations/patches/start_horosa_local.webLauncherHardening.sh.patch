@@ -752,11 +752,13 @@ _rc_backend=0; wait "${_rc_backend_pid}" || _rc_backend=$?
 if [ "${_rc_chart}" != "0" ]; then
   diag_log "blocked: port ${CHART_PORT} still in use after reclaim -> exit 3 (retryable)"
   echo "port ${CHART_PORT} is already in use."
