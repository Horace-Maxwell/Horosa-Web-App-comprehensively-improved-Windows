{
  "name": "horosa-astrostudyui",
  "private": true,
  "description": "Horosa local-first web workspace and AI analysis surface.",
  "license": "AGPL-3.0-only",
  "keywords": [
    "horosa",
    "astrology",
    "metaphysics",
    "local-first",
    "umi"
  ],
  "scripts": {
    "start": "node scripts/umi-runner.js dev",
    "build": "node scripts/patch-dom-align-zoom.js && node scripts/umi-runner.js build && node scripts/scrub-build-paths.js dist && node scripts/write-build-info.js dist && node scripts/inject-preload.js dist && node scripts/check-chunk-dup.js dist && node scripts/legacy-engine-floor.js --dist dist",
    "build:file": "node scripts/patch-dom-align-zoom.js && node scripts/umi-runner.js build --for-file && node scripts/scrub-build-paths.js dist-file && node scripts/write-build-info.js dist-file && node scripts/inject-preload.js dist-file && node scripts/check-chunk-dup.js dist-file && node scripts/legacy-engine-floor.js --dist dist-file",
    "build:cities": "node scripts/build-cities.js",
    "build:technique-pinyin": "node scripts/build-technique-pinyin.js",
    "postinstall": "node scripts/patch_quill_domnodeinserted.js && node scripts/patch-dom-align-zoom.js && umi generate tmp",
    "prettier": "prettier --write '**/*.{js,jsx,tsx,ts,less,md,json}'",
    "test": "umi-test",
    "test:coverage": "umi-test --coverage",
    "planetarium:perf": "node scripts/planetariumPerfSmoke.js"
  },
  "lint-staged": {
    "*.{js,jsx,less,md,json}": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "prettier --parser=typescript --write"
    ]
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@ant-design/pro-layout": "^6.5.0",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@pdf-lib/fontkit": "^1.1.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "astronomy-engine": "2.1.19",
    "babylonjs": "^7.54.3",
    "d3": "^7.8.4",
    "docx": "^9.5.1",
    "dompurify": "^2.5.9",
    "echarts": "^6.1.0",
    "highlight.js": "^11.9.0",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.14.0",
    "js-rsa": "^1.0.3",
    "jszip": "^3.10.1",
    "katex": "^0.16.10",
    "lunar-javascript": "^1.7.7",
    "marked": "^4.3.0",
    "mustache": "^4.2.0",
    "node-forge": "^1.3.1",
    "pdf-lib": "^1.17.1",
    "react": "17.x",
    "react-dom": "17.x",
    "react-quill": "^1.3.5",
    "three": "0.185.1",
    "tz-lookup": "^6.1.25",
    "umi": "^3.5.41"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@umijs/preset-react": "1.x",
    "@umijs/test": "^3.5.41",
    "esbuild": "0.12.15",
    "fake-indexeddb": "^4.0.2",
    "jsdom": "^16.7.0",
    "lint-staged": "^10.0.7",
    "opencc-js": "^1.3.1",
    "pinyin-pro": "^3.28.1",
    "prettier": "^2.2.0",
    "puppeteer-core": "^21.11.0",
    "typescript": "^4.1.2",
    "yorkie": "^2.0.0"
  }
}
