{
	"schema": "geomancy.abjad/v1",
	"note": "标准 abjad 字母数值序(公有记数体系)。图形之数 = 其阿拉伯名各字母数值之和;定冠词与空格不计。各家取名不同则数亦不同,此处依所载阿拉伯名表。",
	"letters": {
		"ا": 1,
		"أ": 1,
		"إ": 1,
		"آ": 1,
		"ء": 1,
		"ب": 2,
		"ج": 3,
		"د": 4,
		"ه": 5,
		"ة": 5,
		"و": 6,
		"ؤ": 6,
		"ز": 7,
		"ح": 8,
		"ط": 9,
		"ي": 10,
		"ى": 10,
		"ئ": 10,
		"ك": 20,
		"ل": 30,
		"م": 40,
		"ن": 50,
		"س": 60,
		"ع": 70,
		"ف": 80,
		"ص": 90,
		"ق": 100,
		"ر": 200,
		"ش": 300,
		"ت": 400,
		"ث": 500,
		"خ": 600,
		"ذ": 700,
		"ض": 800,
		"ظ": 900,
		"غ": 1000
	},
	"ignore_chars": [
		" ",
		"ـ",
		"ٱ"
	],
	"ignore_words": [
		"ال"
	]
}
